# ==========================================
# Etapa 1: Compilación (Entorno Node.js)
# ==========================================
FROM node:22-alpine AS builder
WORKDIR /app

# Activar corepack para usar pnpm de forma nativa y segura
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copiar los archivos de configuración
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/ ./packages/
COPY apps/salc-portal/ ./apps/salc-portal/

RUN pnpm install --frozen-lockfile --ignore-scripts

# --- EL ENGAÑO A VITE ---
# Le pasamos textos estáticos falsos en lugar de ARGs. 
# Vite quemará "___PLACEHOLDER___" en el código JS compilado.
ENV VITE_API_URL="__VITE_API_URL_PLACEHOLDER__"
ENV VITE_CLASS_TRACK_URL="__VITE_CLASS_TRACK_URL_PLACEHOLDER__"

RUN pnpm --filter salc-portal build

# ==========================================
# Etapa 2: Servidor Web de Producción (Nginx)
# ==========================================
FROM nginx:alpine AS production

COPY apps/salc-portal/nginx.config /etc/nginx/conf.d/default.conf
COPY --from=builder /app/apps/salc-portal/dist /usr/share/nginx/html

# --- INYECCIÓN DE RUNTIME ---
# Nginx ejecutará automáticamente cualquier script .sh dentro de esta carpeta al iniciar
COPY apps/salc-portal/entrypoint.sh /docker-entrypoint.d/40-inject-env.sh

# Le damos permisos de ejecución al script
RUN chmod +x /docker-entrypoint.d/40-inject-env.sh

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]