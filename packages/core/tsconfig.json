{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "verbatimModuleSyntax": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "composite": true,
        "declaration": true,
        "outDir": "./dist",
        "paths": {
            "@salc/core/*": [
                "./src/*"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}